{
  "$description": "Codex design tokens. Single source of truth: scripts/build.mjs turns this file into dist/tokens.css, dist/tokens.js and the palette stylesheets. Colors come from the Claude Design files 'Grow Dashboard' (turns 8-11) and 'ISO Coach' (turn 1).",
  "prefix": "cx",
  "themes": {
    "paper": {
      "$description": "Default. Iron-gall ink on laid paper.",
      "color": {
        "paper": "#dccfae",
        "paper-glow": "rgba(255, 251, 236, 0.5)",
        "paper-shade": "rgba(178, 150, 104, 0.26)",
