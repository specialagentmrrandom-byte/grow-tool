      "color": {
        "paper": "#211b14",
        "paper-glow": "rgba(255, 232, 190, 0.05)",
        "paper-shade": "rgba(0, 0, 0, 0.28)",
        "paper-grain": "rgba(255, 238, 205, 0.03)",
        "paper-vignette": "rgba(0, 0, 0, 0.45)",
        "ground": "#0f0c09",
        "ink": "#e6d8b8",
