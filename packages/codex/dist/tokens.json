  "font": {
    "$description": "Font stacks. `display` sets titles, big numbers and the wheel; `text` everything else. Both follow `serif` unless a variant brings its own typefaces (variants.<name>.font).",
    "serif": "'EB Garamond', Garamond, 'Adobe Garamond Pro', 'Times New Roman', serif",
    "display": "var(--cx-font-serif)",
    "text": "var(--cx-font-serif)",
    "mono": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace",
    "adjust": "none"
  },
  "text": {
    "$description": "Type scale in rem (16px root). Sizes taken from the 390px phone sheets.",
    "2xs": "0.625rem",
    "xs": "0.78125rem",
    "sm": "0.84375rem",
    "md": "0.90625rem",
    "lg": "0.96875rem",
    "xl": "1.0625rem",
    "2xl": "1.3125rem",
    "3xl": "1.6875rem",
    "4xl": "2.125rem",
    "5xl": "3.5rem",
    "6xl": "4.5rem"
  },
