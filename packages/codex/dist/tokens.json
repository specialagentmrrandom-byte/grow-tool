        "plum": "#a896c9",
        "sepia": "#c3a47e",
        "slate": "#8fb0bf"
      }
    }
  },
  "alpha": {
    "$description": "Ink strengths, mixed from --cx-ink so they follow the theme. Name = what it is used for.",
    "ink-strong": 0.86,
    "ink-soft": 0.78,
    "ink-muted": 0.7,
    "ink-faint": 0.55,
    "line-strong": 0.5,
    "line": 0.42,
    "rule": 0.32,
    "rule-soft": 0.2,
    "track": 0.18,
    "wash": 0.05
  },
  "semantic": {
    "$description": "Roles apps should reach for first. Values are references to other tokens.",
    "text": "color.ink",
