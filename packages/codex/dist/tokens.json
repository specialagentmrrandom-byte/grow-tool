    "eyebrow": "0.3em",
    "label": "0.15em",
    "button": "0.06em"
  },
  "leading": {
    "tight": "1",
    "snug": "1.3",
    "body": "1.45",
    "loose": "1.6"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "7": "34px"
  },
  "radius": {
    "sheet": "3px",
    "none": "0"
  },
  "size": {
    "touch": "44px",
    "sheet-phone": "390px",
    "sheet-folio": "1180px",
    "progress": "5px",
    "swatch-w": "22px",
    "swatch-h": "3px",
    "shadow": "4px",
    "shadow-sm": "2px"
  },
  "hatch": {
    "$description": "The drawn shadow under buttons, chips and .cx-hatched cards: pen lines at an angle, a line width and the distance from one line to the next. How far the shadow falls is size.shadow / size.shadow-sm; its ink is color.shade / color.shade-strong.",
    "angle": "-45deg",
    "width": "1px",
    "gap": "3.75px"
  },
  "pen": {
    "$description": "The hand of the default look (Notebook): what createPen() draws with. hatch: diagonal | cross | stipple | scribble | engrave | contour | hachure | waves | mixed; tremble: steady | quill | sketch | tremor | brush | dry | mixed; amount 0–3 (shake), density 0.5–2.2 (1 = hatch.gap), angle −90…90, seed 1–99999. Variants set their own under variants.<name>.pen (plus optional width, lift, liftSm in px), which also sets the CSS hatching (--cx-hatch-*, --cx-size-shadow*) so the page looks right before and without the pen. `wheel` is how @rafime/wheel hatches its periods (bigger areas than a button shadow): hatch, density, angle, amount, rim and tremble (how its lines are drawn: a trembling style, or 'filter' for the old SVG ink filter) ('current' = only the current period, 'all' = every period, the others lighter); read with variantWheelHatch().",
    "hatch": "diagonal",
    "tremble": "quill",
    "amount": 1,
    "density": 1,
    "angle": -45,
    "seed": 1789,
    "wheel": {
      "hatch": "diagonal",
      "density": 0.65,
      "angle": 38,
      "amount": 0.6,
      "rim": "current",
      "tremble": "quill"
    }
  },
  "motion": {
    "ease": "cubic-bezier(0.22, 1, 0.36, 1)",
    "fast": "160ms",
    "slow": "420ms"
  },
