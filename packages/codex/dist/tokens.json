        "on-ink": "#dccfae",
        "shade": "rgba(51, 41, 28, 0.42)",
        "shade-strong": "rgba(51, 41, 28, 0.62)",
        "$shade": "Drawn shadows: the hatching under buttons and chips. Ink with alpha; lighter at night so the chalk lines stay a shadow, not a glow."
      },
      "pigment": {
        "rust": "#9c4a2f",
        "ochre": "#a8792c",
        "amber": "#b3782a",
        "ochre-ink": "#8a5c1e",
        "moss": "#4a6b3d",
