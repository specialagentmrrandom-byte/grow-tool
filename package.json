{
    "name": "grow-tool",
    "version": "1.0.0",
    "type": "module",
    "description": "OG Grow Journal Assistant — a free, offline-first PWA grow diary for cannabis growers: track a plant from seed to harvest with a visual timeline, tent planner, DLI calculator, reminders, photo gallery and shareable reports.",
    "keywords": [
        "cannabis",
        "grow-journal",
        "grow-diary",
        "pwa",
        "offline-first",
        "gardening",
        "overgrow",
        "typescript",
        "vite"
    ],
    "author": "Rafime (Left4Dev)",
    "license": "MIT",
    "homepage": "https://grow.rafime.de",
    "repository": {
        "type": "git",
        "url": "https://github.com/specialagentmrrandom-byte/grow-tool.git"
    },
    "bugs": {
        "url": "https://github.com/specialagentmrrandom-byte/grow-tool/issues"
    },
    "scripts": {
        "predev": "node scripts/bundle-emoji.mjs",
        "dev": "vite",
        "prebuild": "node scripts/bundle-emoji.mjs",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@twemoji/api": "^17.0.3",
        "@twemoji/svg": "^15.0.0",
        "@vitest/ui": "^5.0.1",
        "jsdom": "^30.1.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^5.0.1"
    }
}
