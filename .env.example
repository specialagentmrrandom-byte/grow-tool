# Optional. Without these two values the app builds and runs exactly as it does
# offline: no account screen, no sync, everything on the device.
#
# Copy this file to .env.local and point it at your own Supabase project to work
# on the sync side of the app.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: Cloudflare Turnstile (bot protection on sign-up / sign-in / password
# reset). Set the matching secret in Supabase → Authentication → Attack
# Protection as well, or every sign-in is rejected. Empty = no captcha.
VITE_TURNSTILE_SITE_KEY=
